generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  uniqueId      String    @unique // 6-digit unique ID
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("user") // "user" or "admin"
  country       String?
  currency      String?
  locale        String    @default("ar")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  wallet   Wallet?
  orders   Order[]
  visits   Visit[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  type        String   // "recharge", "purchase", "refund"
  amount      Float
  description String?
  orderId     String?
  redeemCodeId String?
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model RedeemCode {
  id        String    @id @default(cuid())
  code      String    @unique
  value     Float
  isUsed    Boolean   @default(false)
  usedBy    String?   // user uniqueId
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Product {
  id              String   @id @default(cuid())
  name            String
  nameEn          String?
  nameFr          String?
  description     String
  descriptionEn   String?
  descriptionFr   String?
  price           Float    // in USD
  image           String?
  category        String
  type            String   @default("product") // "product" or "service"
  deliveryContent String?  // digital content delivered after purchase
  countries       String?  // comma-separated country codes, null = all
  isActive        Boolean  @default(true)
  stock           Int      @default(-1) // -1 = unlimited
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders OrderItem[]
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  userUid    String      // 6-digit user ID
  total      Float       // in USD
  status     String      @default("completed") // "pending", "completed", "cancelled"
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int    @default(1)
  price     Float  // price at time of purchase in USD

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Visit {
  id        String   @id @default(cuid())
  userId    String?
  country   String?
  ip        String?
  userAgent String?
  page      String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model ExchangeRate {
  id        String   @id @default(cuid())
  currency  String   @unique
  rate      Float    // rate relative to USD
  updatedAt DateTime @updatedAt
}
